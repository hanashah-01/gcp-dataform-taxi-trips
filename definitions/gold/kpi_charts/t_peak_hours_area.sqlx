config {
  type: "table",
  schema: "sc_gold",
  name: "t_peak_hours_by_area",
  description: "Busiest pickup hour per community area"
}

SELECT
  ca.community_name,
  dt.date,
  EXTRACT(HOUR FROM trip_start_timestamp) AS pickup_hour,
  COUNT(trip_id) AS trip_count
FROM ${ref("t_fact_chicago_taxi_trips")} tx 
LEFT JOIN ${ref("t_dim_date")} AS dt 
ON tx.trip_date_id = dt.date_id
LEFT JOIN ${ref("t_dim_community_area")} AS ca 
ON tx.pickup_community_area_id = ca.community_area_id
GROUP BY community_name, date, pickup_hour
ORDER BY community_name, date, pickup_hour