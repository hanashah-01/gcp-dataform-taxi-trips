config {
  type: "table",
  schema: "sc_gold",
  name: "t_peak_hours_by_area",
  description: "Busiest pickup hour per community area"
}

SELECT
  pickup_community_area_id,
  trip_date_id,
  EXTRACT(HOUR FROM trip_start_timestamp) AS pickup_hour,
  COUNT(trip_id) AS trip_count
FROM ${ref("t_fact_chicago_taxi_trips")} 
GROUP BY pickup_community_area_id, trip_date_id, pickup_hour
ORDER BY pickup_community_area_id, trip_date_id, pickup_hour