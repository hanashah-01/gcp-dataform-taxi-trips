config {
  type: "table",
  schema: "sc_gold",
  name: "t_top_payment_types",
  description: "Top payment types used by passengers"
}

SELECT
  payment_type_id,
  pickup_community_area_id,
  trip_date_id,
  COUNT(trip_id) AS total_trips,
FROM ${ref("t_fact_chicago_taxi_trips")}
GROUP BY payment_type_id, pickup_community_area_id, trip_date_id